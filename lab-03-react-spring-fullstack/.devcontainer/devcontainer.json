{
  "name": "StackQuest Lab 03 - Full-stack Development",
  "dockerComposeFile": ["../compose.yml"],
  "service": "dev",
  "runServices": ["postgres", "frontend", "dev"],
  "workspaceFolder": "/workspaces/lab",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": ["redhat.java", "vscjava.vscode-java-debug", "vscjava.vscode-java-test", "vscjava.vscode-maven"],
      "settings": {"java.jdt.ls.java.home": "/opt/java/openjdk"}
    }
  }
}
